<%- include('../partials/head', { title: 'Услуги IT' }) %>
<%- include('../partials/nav', { active: 'services' }) %>

  <main class="admin-main">
    <div class="admin-head">
      <div>
        <h2>Услуги</h2>
      </div>
      <a href="/admin/services/new" class="btn btn-primary">Добавить услугу</a>
    </div>

    <% if (flash) { %>
      <div class="admin-flash"><%= flash %></div>
    <% } %>

    <% if (services.length === 0) { %>
      <div class="admin-empty">Пока нет ни одной услуги.</div>
    <% } else { %>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Название</th>
            <th>Порядок</th>
            <th>Статус</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% services.forEach((s) => { %>
            <tr>
              <td><%= s.name %></td>
              <td><%= s.order %></td>
              <td><%= s.isPublished ? 'Опубликована' : 'Черновик' %></td>
              <td>
                <div class="row-actions">
                  <a href="/admin/services/<%= s.id %>/edit" class="btn btn-outline">Изменить</a>
                  <form method="post" action="/admin/services/<%= s.id %>/delete"
                        onsubmit="return confirm('Удалить услугу «<%= s.name %>»?')">
                    <button type="submit" class="btn btn-outline">Удалить</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </main>

</body>
</html>
