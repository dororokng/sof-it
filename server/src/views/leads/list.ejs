<%- include('../partials/head', { title: 'Заявки' }) %>
<%- include('../partials/nav', { active: 'leads' }) %>

  <main class="admin-main">
    <div class="admin-head">
      <div>
        <h2>Заявки с сайта</h2>
      </div>
    </div>

    <% if (flash) { %>
      <div class="admin-flash"><%= flash %></div>
    <% } %>

    <% if (leads.length === 0) { %>
      <div class="admin-empty">Пока нет ни одной заявки.</div>
    <% } else { %>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Дата</th>
            <th>Имя</th>
            <th>Компания</th>
            <th>Телефон</th>
            <th>E-mail</th>
            <th>Комментарий</th>
            <th>Статус</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% leads.forEach((l) => { %>
            <tr>
              <td><%= l.createdAt.toLocaleString('ru-RU') %></td>
              <td><%= l.name %></td>
              <td><%= l.company || '—' %></td>
              <td><a href="tel:<%= l.phone %>"><%= l.phone %></a></td>
              <td><% if (l.email) { %><a href="mailto:<%= l.email %>"><%= l.email %></a><% } else { %>—<% } %></td>
              <td><%= l.comment || '—' %></td>
              <td><%= l.isProcessed ? 'Обработана' : 'Новая' %></td>
              <td>
                <div class="row-actions">
                  <form method="post" action="/admin/leads/<%= l.id %>/toggle">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button type="submit" class="btn btn-outline"><%= l.isProcessed ? 'Вернуть в новые' : 'Отметить обработанной' %></button>
                  </form>
                  <form method="post" action="/admin/leads/<%= l.id %>/delete"
                        onsubmit="return confirm('Удалить заявку от «<%= l.name %>»?')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button type="submit" class="btn btn-outline">Удалить</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </main>

</body>
</html>
