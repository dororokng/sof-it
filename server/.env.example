# Скопируйте в .env (server/.env), в git не попадает.
DATABASE_URL="postgresql://sofit:change_me@localhost:5432/sofit"
SESSION_SECRET=change_me_to_a_random_string
PORT=4000
# На реальном сервере — обязательно "production" (влияет на кеширование EJS-view,
# secure-флаг cookie сессии и другие внутренние оптимизации Express). Для
# локальной разработки не задавать. Если задано "production", сервер при
# старте откажется работать без настоящего SESSION_SECRET (не равного
# значению-примеру выше) и без заданного TRUST_PROXY — см. ниже.
NODE_ENV=production

# Кому доверять заголовки X-Forwarded-For/X-Forwarded-Proto (нужны для
# правильного req.ip в rate-limit на /admin/login и /api/leads, и для
# secure-cookie за HTTPS-терминацией на реверс-прокси). Не задано — сервер
# никому не доверяет, req.ip = реальный IP TCP-подключения (ок для локальной
# разработки и для прод-деплоя без реверс-прокси перед Node).
#   loopback — Nginx и Node на одной машине (проксирует через 127.0.0.1).
#   1        — перед Node ровно один реверс-прокси на отдельном хосте/контейнере.
# Значение "true" запрещено намеренно (сервер откажется стартовать) — оно
# доверяет X-Forwarded-For от ЛЮБОГО клиента, а не только от реального
# прокси, что позволяет подделать IP и обойти rate-limit.
TRUST_PROXY=loopback
